[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scenes/UI/HUD/Allies/allies_entry_row.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://shared_assets/UI/StonePatternRect9.png" id="2_stone"]
[ext_resource type="StyleBox" path="res://shared_assets/UI/button_normal_styleboxtexture.tres" id="3_normal"]
[ext_resource type="StyleBox" path="res://shared_assets/UI/button_hover_styleboxtexture.tres" id="4_hover"]
[ext_resource type="StyleBox" path="res://shared_assets/UI/button_pressed_styleboxtexture.tres" id="5_pressed"]
[ext_resource type="StyleBox" path="res://shared_assets/UI/button_disabled_styleboxtexture.tres" id="6_disabled"]
[ext_resource type="FontFile" path="res://Fonts/BlackChancery.tres" id="7_font"]

[node name="AlliesEntryRow" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 72)
theme_override_constants/separation = 6
script = ExtResource("1_script")

[node name="SelectButton" type="Button" parent="."]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
theme_override_styles/normal = ExtResource("3_normal")
theme_override_styles/hover = ExtResource("4_hover")
theme_override_styles/pressed = ExtResource("5_pressed")
theme_override_styles/disabled = ExtResource("6_disabled")

[node name="ContentMargin" type="MarginContainer" parent="SelectButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 5
theme_override_constants/margin_top = 5
theme_override_constants/margin_right = 5
theme_override_constants/margin_bottom = 5

[node name="Content" type="HBoxContainer" parent="SelectButton/ContentMargin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="IconFrame" type="NinePatchRect" parent="SelectButton/ContentMargin/Content"]
custom_minimum_size = Vector2(58, 58)
layout_mode = 2
mouse_filter = 2
texture_filter = 1
texture = ExtResource("2_stone")
patch_margin_left = 8
patch_margin_top = 8
patch_margin_right = 8
patch_margin_bottom = 8
axis_stretch_horizontal = 1
axis_stretch_vertical = 1

[node name="Icon" type="TextureRect" parent="SelectButton/ContentMargin/Content/IconFrame"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 5.0
offset_top = 5.0
offset_right = -5.0
offset_bottom = -5.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="SelectButton/ContentMargin/Content"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="SelectButton/ContentMargin/Content/Text"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.96, 0, 1)
theme_override_fonts/font = ExtResource("7_font")
theme_override_font_sizes/font_size = 17
text = "Ally Name"
clip_text = true

[node name="Detail" type="Label" parent="SelectButton/ContentMargin/Content/Text"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.78, 0.78, 0.78, 1)
theme_override_font_sizes/font_size = 12
text = "Permanent ally"
clip_text = true

[node name="RetainButton" type="Button" parent="."]
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
toggle_mode = true
button_pressed = true
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_colors/font_pressed_color = Color(1, 0.96, 0, 1)
theme_override_fonts/font = ExtResource("7_font")
theme_override_font_sizes/font_size = 15
theme_override_styles/normal = ExtResource("3_normal")
theme_override_styles/hover = ExtResource("4_hover")
theme_override_styles/pressed = ExtResource("5_pressed")
theme_override_styles/disabled = ExtResource("6_disabled")
text = "Keep"

[connection signal="pressed" from="SelectButton" to="." method="_on_select_button_pressed"]
[connection signal="toggled" from="RetainButton" to="." method="_on_retain_button_toggled"]
