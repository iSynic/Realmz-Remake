},{"id":"Data ED3:macro:1196","levelType":null,"levelIndex":null,"active":true,"doorid":0,"landid":0,"targetX":0,"targetY":0,"percent":0,"coordinate":null,"actions":[{"kind":"classic","slot":0,"rawCode":1,"code":1,"id":1246,"label":"Text","category":"ui_text","gosub":false},{"kind":"classic","slot":1,"rawCode":111,"code":111,"id":0,"label":"Return from GOSUB","category":"branch","gosub":false}],"macroId":1196}],"extraCodes":[{"id":1236,"values":[760,762,0,0,0]},{"id":1237,"values":[48,1,0,830,0]},{"id":1508,"values":[29,1,0,1026,0]},{"id":1509,"values":[1107,1109,0,0,0]},{"id":1510,"values":[2,0,0,1027,0]},{"id":1824,"values":[64,1,0,1196,0]}],"messages":[{"id":1107,"text":"You overhear a conversation: \"I can't believe that Wailsrond has fallen!\" A merchant exclaims. \"Aye!\" Another one adds. \"I fear trade will suffer very much, and we will live through hard economic times.\"","authored":false},{"id":1108,"text":"You overhear a conversation: \"Did you hear? Wailsrond has fallen!\" A woman exclaims. \"Aye!\" Another one adds. \"I fear that Sharranth cannot be stopped, and soon the Warlord will attack us as well!\"","authored":false},{"id":1109,"text":"You overhear a conversation: \"Me cain't believe that Wailsrond has fallen!\" A sailor exclaims. \"Oy!\" A miner adds. \"An' ye cain be sure that Sharranth will come fer us next! These be dark times acomin', friend, even darker than six moons past.\"","authored":false},{"id":1110,"text":"\"Were are the Heroes of the Sword Lands? Why aren't they doing anything to stop this?\"","authored":false},{"id":1246,"text":"\"Bah!\" Someone else replies. \"Don't count on them! I heard that they got a better offer from the Warlord of Sharranth, and took it!\" A woman shakes her head, sadly: \"Then we may be doomed ...\"","authored":false}],"randomLevels":[],"optionLabels":[],"dispatcherNoops":[]}
