:[0,10,0,0,0]},{"id":250,"values":[-1,1,3,10090,0]},{"id":255,"values":[1,17,900,158,163]},{"id":256,"values":[1,31,70,0,0]},{"id":269,"values":[0,3,28,193,0]},{"id":277,"values":[4,5,0,0,0]},{"id":278,"values":[-3,2,8,632,0]},{"id":279,"values":[186,0,10049,0,0]},{"id":321,"values":[20,0,0,100,0]},{"id":364,"values":[1,22,73,0,0]},{"id":365,"values":[1,24,75,0,0]},{"id":375,"values":[1408,3,0,0,0]},{"id":388,"values":[2301,1,0,0,0]},{"id":428,"values":[4606,3,30,0,0]},{"id":462,"values":[-1,1,1,699,0]},{"id":607,"values":[0,1,36,74,-4]},{"id":639,"values":[5,6,83,0,0]},{"id":643,"values":[1,1,0,0,0]},{"id":645,"values":[250,0,-1,0,0]},{"id":655,"values":[2,1,0,0,0]},{"id":659,"values":[10,0,0,0,1]},{"id":660,"values":[0,0,33,72,2]},{"id":661,"values":[1,0,88,48,0]}],"messages":[{"id":0,"text":"Do Not Use","authored":false},{"id":1,"text":"You detect no signs of a trap.","authored":false},{"id":2,"text":"You have checked the lock and are sure that it is not trapped.","authored":false},{"id":3,"text":"You have failed to pick the lock.","authored":false},{"id":4,"text":"The lock is now open.","authored":false},{"id":5,"text":"You have been successful at disarming the trap.","authored":false},{"id":6,"text":"You have failed to disarm the trap.","authored":false},{"id":7,"text":"Your inspection has detected a trap!","authored":false},{"id":207,"text":"You see a small notch carved into the wall.  It holds an iron chest bolted to the wall.","authored":false},{"id":209,"text":"With the trap triggered, the lock is quickly defeated.  Inside, you find treasure.","authored":false},{"id":210,"text":"You hear a click as a trap disarms and the lock opens.  Inside you find treasure.","authored":false},{"id":218,"text":"The door to this chamber is locked.  It is made of quite solid oak.","authored":false},{"id":50,"text":"You enter the guard house outside the main gate to Castle Anthrax.  Several guards keep a wary eye on you as you approach the head Magistrate.  He is a stately looking man in fine robes.","authored":false},{"id":51,"text":"Judging by the man's large girth, robes are not all he fancies.  You approach his fine oak desk.  \"Present your invitation so I may validate it for passage to yon castle.\"","authored":false},{"id":75,"text":"You have entered a rather fine tavern filled with only the best citizens of Bywater.  Most of the tables are filled with patrons eating spiced potatoes and engaged in interesting discussions.  You find yourself a table near the back.","authored":false},{"id":76,"text":"You are standing in a tavern.","authored":false},{"id":86,"text":"\"Oh, I don't really know much.\"  She smiles and points to the seedy looking man.  \"Ask him, he's been telling me all kinds of stories all day.\"","authored":false},{"id":91,"text":"They make for the door in haste, yelling, \"Targ the thief has gotten his due! Any man who follows us shall join him in Hades!\"  Apparently, they did not see the slip of paper Targ gave you.","authored":false},{"id":94,"text":"You are at your table when the town guards show up.  Luckily, nobody wants to get so involved as to implicate you in any manner.  The guards bind Targ's arms to his chest and drag him from the inn.","authored":false},{"id":95,"text":"As you examine the slip of paper, you see that it's a map describing the location of an old crypt in the graveyard.","authored":false},{"id":620,"text":"You enter the slave prison.  A potbellied Corporal Sampson is slumped over a shaky table.  He's slept through the entire ordeal that just took place outside.  The smell of elderberry wine permeates his clothes.  You try to rouse him to collect your fee.","authored":false},{"id":61,"text":"He bids you farewell as you make your way from the gate house.","authored":false},{"id":69,"text":"The town patrol waves you through as they hand you a map showing where you can buy provisions.","authored":false},{"id":180,"text":"This appears to be the site of a rather large cavern that has recently caved in.","authored":false},{"id":183,"text":"You have succeeded in uncovering the passage behind the cave-in.  It is now  possible to traverse the passage to wherever it may take you.","authored":false},{"id":185,"text":"The tunnel continues west.  You smell decaying flesh.  The odor is almost overwhelming.","authored":false},{"id":241,"text":"After the thrashing you gave the creatures at the gate before, the gate is now only lightly guarded.","authored":false},{"id":238,"text":"This is the gate to enter the Spider Tower.  Herein dwells an evil cult bent on total dominance of the world by arachnids and others of their ilk.  The gates are massive, and the walls are guarded by fierce creatures.  Do you wish to attack?","authored":false},{"id":240,"text":"You have managed to battle your way past the gate.  Something tells you that the tough battles are yet to come.","authored":false},{"id":678,"text":"You are overcome by a bout of dizziness.  For some inexplicable reason, your compass appears unable to provide you with an accurate reading.","authored":false},{"id":848,"text":"You can now see in the dim light.","authored":false},{"id":849,"text":"The light fades leaving you in darkness.","authored":false},{"id":520,"text":"You see the remains of yet another small child.  Blood still trickles from a jugular  recently opened to let this innocent child's life leak away.  Do you wish to dig the child a grave.","authored":false},{"id":521,"text":"That will be one foul meal that shall go untasted.  Whatever could prey on helpless farmers and small children deserves this grave far more than this poor child.","authored":false},{"id":522,"text":"As you are leaving the cave you hear a loud roar behind you.  It comes from where you found the small child.  As you attempt to determine the identity of the creatures you see a group of large trolls running in your direction on flapping feet.","authored":false},{"id":15,"text":"Who is so brave as to volunteer?","authored":false},{"id":376,"text":"The floor opens up underneath you.  Those that do not perform an acrobatic act, fall in and take damage.","authored":false},{"id":377,"text":"You quickly scale the rough sides of the pit and get out.","authored":false},{"id":450,"text":"Upon kneeling on the symbols, a magical display of energy sweeps across the floor. Energy beams of light in a myriad of colors appear from all directions.  They strike all those not within the symbols.","authored":false},{"id":451,"text":"After the discharge of light beams, the protective energy field vanishes.  Inside the sphere, the vortex of mist forms the visage of a hideous beast.  It stares intently into your eyes and begins to communicate telepathically.","authored":false},{"id":506,"text":"At the bottom of the shaft is a large pile of gold coins.  Do you wish to take them?","authored":false},{"id":508,"text":"Large rocks break loose from the ceiling.  Those who are not quick enough fail to get out of the way and take damage.","authored":false},{"id":560,"text":"Large boulders careen downwards from a ridge above.  Those not fast enough to avoid the rocks are crushed beneath a hail of missiles.","authored":false},{"id":561,"text":"The hail of boulders forces you to take up a defensive position.  Gnath seize the opportunity to close ranks and attack.","authored":false},{"id":562,"text":"They carried little of value.  This was a perfect position for setting up an ambush.  Be careful of similar attacks in the future.","authored":false},{"id":698,"text":"As soon as you step into the hidden passage, you are assaulted by a mental attack.  It is a psychic barrier used to prevent weak-minded Dogre from entering this area of the fortress.  Your magical energy drains from your body.","authored":false},{"id":867,"text":"You arrived in Bywater just in time as a winter storm has just covered the entire region in a thick blanket of snow.","authored":false}],"randomLevels":[{"id":"land:0:randlevel","isDark":false,"landlook":0,"levelIndex":0,"levelType":"land","useLos":false,"rects":[]},{"id":"land:1:randlevel","isDark":true,"landlook":3,"levelIndex":1,"levelType":"land","useLos":true,"rects":[{"battleRange":[158,162],"bottom":90,"left":4,"only":false,"option":0,"percent":0,"randomDoorPercent":[0,0,0],"randomDoors":[0,0,0],"rectIndex":17,"right":29,"sound":117,"text":0,"top":60}]},{"id":"land:4:randlevel","isDark":false,"landlook":4,"levelIndex":4,"levelType":"land","useLos":true,"rects":[]}],"optionLabels":[],"dispatcherNoops":[{"triggerId":"Data ED3:macro:73","slot":2,"rawCode":200}]}
